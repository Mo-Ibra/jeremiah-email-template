# --- Database (Neon) ---
# PostgreSQL connection string for the Neon database.
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# --- App ---
# Public base URL of the application (used to build email/review links).
PUBLIC_BASE_URL=http://localhost:3000

# --- Resend (email) ---
# API key created at https://resend.com/api-keys (re_...)
RESEND_API_KEY=re_xxx
# Verified sender used in review emails ("Name <email>").
RESEND_FROM_EMAIL=reviews@example.com
RESEND_FROM_NAME=Example Cafe
# Optional: Resend webhook signing secret (Svix) for /api/webhooks/resend.
RESEND_WEBHOOK_SECRET=whsec_xxx

# --- Dashboard (static login) ---
# Static credentials for the business owner dashboard (no user table).
DASHBOARD_EMAIL=owner@example.com
DASHBOARD_PASSWORD=change-me-to-a-strong-password
# Secret used to sign the dashboard session cookie (>= 32 random chars).
DASHBOARD_SESSION_SECRET=generate-with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Business the dashboard operates on (slug); falls back to the first business row.
DASHBOARD_BUSINESS_SLUG=demo
